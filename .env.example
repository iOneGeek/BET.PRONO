# Copie ce fichier vers local.env (local) et configure les variables sur Render (production)
GOOGLE_CLIENT_ID=ton-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ton-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/auth/google/callback

# Base de données PostgreSQL (Neon) : absente = SQLite locale.
# ⚠️ À configurer sur Render (Settings > Environment) et dans local.env, JAMAIS dans le repo.
DATABASE_URL=postgresql://user:motdepasse@host/dbname?sslmode=require
